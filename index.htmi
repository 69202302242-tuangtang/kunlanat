<!DOCTYPE html>
<html lang="th" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบเฝ้าระวังและสารสนเทศทางระบาดวิทยา (Epidemiological Surveillance Dashboard)</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d',
                        },
                        darkbg: '#0f172a',
                        darkcard: '#1e293b',
                        darkborder: '#334155'
                    },
                    fontFamily: {
                        sans: ['Sarabun', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts: Sarabun & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            font-family: 'Sarabun', 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }
        
        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Leaflet Custom Map Styles */
        .leaflet-container {
            background-color: #121621 !important;
            font-family: 'Sarabun', sans-serif;
        }
        .leaflet-popup-content-wrapper {
            background: #1e293b;
            color: #f8fafc;
            border: 1px solid #475569;
            border-radius: 8px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }
        .leaflet-popup-tip {
            background: #1e293b;
        }
        
        /* Pulse Animation for Outbreak Markers */
        @keyframes pulse-red {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .pulse-marker-red {
            border-radius: 50%;
            animation: pulse-red 2s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Navigation / Header -->
    <header class="bg-darkcard border-b border-darkborder sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400">
                    <i data-lucide="activity" class="w-7 h-7"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                        ระบบเฝ้าระวังและสารสนเทศทางระบาดวิทยา
                        <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-medium">Live Surveillance</span>
                    </h1>
                    <p class="text-xs text-slate-400">Epidemiological Surveillance & Disease Trend Analysis System</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="text-right text-xs hidden sm:block">
                    <div class="text-slate-400">อัปเดตข้อมูลล่าสุด</div>
                    <div class="font-medium text-emerald-400 flex items-center gap-1 justify-end">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                        <span id="lastUpdatedText">สัปดาห์ระบาดวิทยาที่ 42 (ต.ค. 2026)</span>
                    </div>
                </div>
                <button id="refreshBtn" onclick="refreshData()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium border border-slate-700 flex items-center gap-1.5 transition">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    <span>รีเฟรช</span>
                </button>
                <button onclick="exportCSV()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-medium flex items-center gap-1.5 shadow-lg shadow-emerald-900/30 transition">
                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                    <span>ส่งออกข้อมูล (CSV)</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Filters Bar -->
    <section class="bg-slate-900/90 border-b border-darkborder px-4 sm:px-6 lg:px-8 py-3">
        <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1 flex items-center gap-1">
                    <i data-lucide="bug" class="w-3.5 h-3.5 text-emerald-400"></i> เลือกโรคเฝ้าระวัง
                </label>
                <select id="diseaseSelect" onchange="handleFilterChange()" class="w-full bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    <option value="dengue">ไข้เลือดออก (Dengue Hemorrhagic Fever)</option>
                    <option value="flu">ไข้หวัดใหญ่ (Influenza)</option>
                    <option value="covid">โรคติดเชื้อไวรัสโคโรนา 2019 (COVID-19)</option>
                    <option value="hfmd">โรคมือ เท้า ปาก (HFMD)</option>
                    <option value="diarrhea">โรคอุจจาระร่วงอย่างแรง (Severe Diarrhea)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1 flex items-center gap-1">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-blue-400"></i> ปีระบาดวิทยา
                </label>
                <select id="yearSelect" onchange="handleFilterChange()" class="w-full bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    <option value="2026" selected>2026 (ปีปัจจุบัน)</option>
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1 flex items-center gap-1">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-amber-400"></i> เขตสุขภาพ / ภาค
                </label>
                <select id="regionSelect" onchange="handleFilterChange()" class="w-full bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    <option value="all">ทุกพื้นที่ทั่วประเทศ (Nationwide)</option>
                    <option value="north">ภาคเหนือ</option>
                    <option value="central">ภาคกลาง / กทม.</option>
                    <option value="ne">ภาคตะวันออกเฉียงเหนือ</option>
                    <option value="south">ภาคใต้</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-medium text-slate-400 mb-1 flex items-center gap-1">
                    <i data-lucide="sliders" class="w-3.5 h-3.5 text-purple-400"></i> ระดับการระบาด
                </label>
                <select id="riskSelect" onchange="handleFilterChange()" class="w-full bg-slate-800 border border-slate-700 text-slate-200 text-xs rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none">
                    <option value="all">ระดับความเสี่ยงทั้งหมด</option>
                    <option value="high">พื้นที่ระบาดสูง (Epidemic Zone)</option>
                    <option value="warning">พื้นที่เฝ้าระวังพิเศษ (Warning Zone)</option>
                    <option value="normal">พื้นที่สถานการณ์ปกติ (Normal Zone)</option>
                </select>
            </div>
        </div>
    </section>

    <!-- Main Content Layout -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- KPI Metrics Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Metric 1: Total Cases -->
            <div class="bg-darkcard border border-darkborder rounded-xl p-4 relative overflow-hidden shadow-lg">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">จำนวนผู้ป่วยสะสม</p>
                        <h3 id="kpiTotalCases" class="text-2xl font-extrabold text-white mt-1">45,820</h3>
                        <p class="text-xs text-slate-400 mt-1">
                            อัตราป่วย: <span id="kpiAttackRate" class="text-emerald-400 font-semibold">68.5</span> /แสนประชากร
                        </p>
                    </div>
                    <div class="p-2.5 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-500/20">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-800 flex items-center text-xs text-emerald-400 font-medium">
                    <i data-lucide="trending-up" class="w-3.5 h-3.5 mr-1"></i>
                    <span id="kpiCasesChange">+12.4%</span> &nbsp;<span class="text-slate-500">เปรียบเทียบสัปดาห์ก่อน</span>
                </div>
            </div>

            <!-- Metric 2: New Cases This Epi-Week -->
            <div class="bg-darkcard border border-darkborder rounded-xl p-4 relative overflow-hidden shadow-lg">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">ผู้ป่วยรายใหม่ (สัปดาห์นี้)</p>
                        <h3 id="kpiNewCases" class="text-2xl font-extrabold text-amber-400 mt-1">1,420</h3>
                        <p class="text-xs text-slate-400 mt-1">
                            Epi-Week <span class="text-amber-300 font-semibold">W42</span>
                        </p>
                    </div>
                    <div class="p-2.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20">
                        <i data-lucide="user-plus" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-800 flex items-center text-xs text-amber-400 font-medium">
                    <i data-lucide="alert-circle" class="w-3.5 h-3.5 mr-1"></i>
                    <span>เกินค่ามัธยฐาน 5 ปี (+8.2%)</span>
                </div>
            </div>

            <!-- Metric 3: Fatalities & CFR -->
            <div class="bg-darkcard border border-darkborder rounded-xl p-4 relative overflow-hidden shadow-lg">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">จำนวนผู้เสียชีวิตสะสม</p>
                        <h3 id="kpiDeaths" class="text-2xl font-extrabold text-rose-500 mt-1">38</h3>
                        <p class="text-xs text-slate-400 mt-1">
                            อัตราป่วยตาย (CFR): <span id="kpiCFR" class="text-rose-400 font-semibold">0.08%</span>
                        </p>
                    </div>
                    <div class="p-2.5 rounded-lg bg-rose-500/10 text-rose-400 border border-rose-500/20">
                        <i data-lucide="heart-pulse" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-800 flex items-center text-xs text-slate-400">
                    <span>เกณฑ์เป้าหมายกระทรวง: &lt; 0.10%</span>
                </div>
            </div>

            <!-- Metric 4: High Risk Outbreak Clusters -->
            <div class="bg-darkcard border border-darkborder rounded-xl p-4 relative overflow-hidden shadow-lg">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-xs font-medium text-slate-400">พื้นที่สีแดง (ระบาดสูง)</p>
                        <h3 id="kpiRedProvinces" class="text-2xl font-extrabold text-red-400 mt-1">8 จังหวัด</h3>
                        <p class="text-xs text-slate-400 mt-1">
                            เฝ้าระวังพิเศษ: <span class="text-amber-400 font-semibold">14 จังหวัด</span>
                        </p>
                    </div>
                    <div class="p-2.5 rounded-lg bg-red-500/10 text-red-400 border border-red-500/20">
                        <i data-lucide="shield-alert" class="w-5 h-5"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-t border-slate-800 flex items-center text-xs text-red-400 font-medium">
                    <i data-lucide="siren" class="w-3.5 h-3.5 mr-1 animate-bounce"></i>
                    <span>เปิด EOC ระดับจังหวัดแล้ว 5 แห่ง</span>
                </div>
            </div>
        </div>

        <!-- Map and Spatial Visualization Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Map Container (Esri World Dark Gray Canvas) -->
            <div class="lg:col-span-7 bg-darkcard border border-darkborder rounded-xl overflow-hidden shadow-xl flex flex-col h-[520px]">
                <div class="p-4 border-b border-darkborder flex justify-between items-center bg-slate-900/60">
                    <div class="flex items-center gap-2">
                        <i data-lucide="map" class="w-5 h-5 text-emerald-400"></i>
                        <h2 class="text-sm font-bold text-white">แผนที่แสดงการกระจายตัวของโรคทางภูมิศาสตร์</h2>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="inline-flex items-center gap-1 bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md text-slate-300">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Esri Dark Gray
                        </span>
                    </div>
                </div>

                <!-- Leaflet Map Div -->
                <div id="map" class="flex-1 w-full relative z-10"></div>

                <!-- Map Legend Overlay Footer -->
                <div class="p-3 bg-slate-900/90 border-t border-darkborder flex flex-wrap items-center justify-between text-xs text-slate-300 gap-2">
                    <div class="flex items-center gap-3">
                        <span class="font-medium text-slate-400">ระดับความเสี่ยง:</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-red-500"></span> ระบาดสูง (&gt;75 percentile)</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-amber-500"></span> เฝ้าระวัง (Median - P75)</span>
                        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-emerald-500"></span> ปกติ (&lt;Median)</span>
                    </div>
                    <div class="text-slate-400 italic text-[11px]">
                        *ขนาดของวงกลมแปรผันตามจำนวนผู้ป่วยสะสม
                    </div>
                </div>
            </div>

            <!-- Epidemiological Trend Charts -->
            <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
                
                <!-- Epi Curve Chart -->
                <div class="bg-darkcard border border-darkborder rounded-xl p-4 shadow-xl flex-1 flex flex-col">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i data-lucide="line-chart" class="w-4 h-4 text-emerald-400"></i>
                            เส้นโค้งทางระบาดวิทยา (Epidemic Curve)
                        </h3>
                        <span class="text-xs text-slate-400">สัปดาห์ระบาดวิทยา (W1 - W42)</span>
                    </div>
                    <div class="flex-1 relative min-h-[220px]">
                        <canvas id="epiCurveChart"></canvas>
                    </div>
                </div>

                <!-- Age & Demographic Chart -->
                <div class="bg-darkcard border border-darkborder rounded-xl p-4 shadow-xl flex-1 flex flex-col">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i data-lucide="bar-chart-3" class="w-4 h-4 text-blue-400"></i>
                            การกระจายผู้ป่วยตามกลุ่มอายุ
                        </h3>
                        <span class="text-xs text-slate-400">จำแนกตามเพศ</span>
                    </div>
                    <div class="flex-1 relative min-h-[180px]">
                        <canvas id="ageGroupChart"></canvas>
                    </div>
                </div>

            </div>
        </div>

        <!-- Detailed Surveillance Data Table & Top Provinces Breakdown -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Top Affected Provinces Bar Chart -->
            <div class="lg:col-span-4 bg-darkcard border border-darkborder rounded-xl p-4 shadow-xl">
                <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                    <i data-lucide="award" class="w-4 h-4 text-amber-400"></i>
                    10 อันดับจังหวัดที่มีอัตราป่วยสูงสุด (ต่อแสนประชากร)
                </h3>
                <div class="h-[280px] relative">
                    <canvas id="topProvincesChart"></canvas>
                </div>
            </div>

            <!-- Outbreak Data Table -->
            <div class="lg:col-span-8 bg-darkcard border border-darkborder rounded-xl shadow-xl flex flex-col">
                <div class="p-4 border-b border-darkborder flex flex-col sm:flex-row justify-between sm:items-center gap-2 bg-slate-900/60">
                    <div class="flex items-center gap-2">
                        <i data-lucide="table" class="w-5 h-5 text-emerald-400"></i>
                        <h3 class="text-sm font-bold text-white">ตารางสถานการณ์เฝ้าระวังรายจังหวัด</h3>
                    </div>
                    <div class="relative">
                        <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-2.5 text-slate-400"></i>
                        <input type="text" id="tableSearch" onkeyup="filterTable()" placeholder="ค้นหาจังหวัด..." class="bg-slate-800 border border-slate-700 text-xs text-slate-200 pl-8 pr-3 py-1.5 rounded-lg focus:outline-none focus:ring-1 focus:ring-emerald-500 w-48">
                    </div>
                </div>

                <div class="overflow-x-auto flex-1">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-900/80 text-slate-400 border-b border-darkborder font-semibold uppercase text-[11px]">
                            <tr>
                                <th class="py-3 px-4">จังหวัด / เขต</th>
                                <th class="py-3 px-4 text-right">จำนวนผู้ป่วย (ราย)</th>
                                <th class="py-3 px-4 text-right">อัตราป่วย (/แสน)</th>
                                <th class="py-3 px-4 text-right">เสียชีวิต (ราย)</th>
                                <th class="py-3 px-4 text-center">สถานการณ์</th>
                                <th class="py-3 px-4 text-center">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody id="surveillanceTableBody" class="divide-y divide-slate-800">
                            <!-- Rows inserted dynamically via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- Public Health Action & Recommendation Panel -->
        <div class="bg-gradient-to-r from-slate-900 via-emerald-950/30 to-slate-900 border border-emerald-500/30 rounded-xl p-4 sm:p-6 shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="space-y-1">
                <h4 class="text-sm font-bold text-emerald-400 flex items-center gap-2">
                    <i data-lucide="check-circle2" class="w-4 h-4"></i>
                    ข้อเสนอแนะและมาตรการทางสาธารณสุข (Public Health Recommendations)
                </h4>
                <p class="text-xs text-slate-300">
                    พื้นที่ที่มีสีแดงให้เร่งรัดการพ่นฝอยละอองรังแกมม่าน้ำ รณรงค์ทำลายแหล่งเพาะพันธุ์ยุงลาย (3 เก็บ ป้องกัน 3 โรค) และประสาน อสม. ลงพื้นที่สอบสวนโรคภายใน 24 ชั่วโมง
                </p>
            </div>
            <button onclick="showActionModal()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs rounded-lg transition shadow-md flex items-center gap-2 whitespace-nowrap">
                <i data-lucide="file-text" class="w-4 h-4"></i>
                พิมพ์รายงานสรุป สร.36
            </button>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-darkcard border-t border-darkborder py-4 mt-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-2">
            <div>
                &copy; 2026 กรมควบคุมโรค / กระทรวงสาธารณสุข (Public Health Epidemiology Dashboard)
            </div>
            <div class="flex items-center gap-3">
                <span class="hover:text-slate-400 cursor-pointer">คู่มือการใช้งาน</span>
                <span>•</span>
                <span class="hover:text-slate-400 cursor-pointer">นิยามผู้ป่วย (Case Definition)</span>
                <span>•</span>
                <span class="hover:text-slate-400 cursor-pointer">GitHub Repository</span>
            </div>
        </div>
    </footer>

    <!-- Custom Modal Toast Alert -->
    <div id="toast" class="fixed bottom-5 right-5 bg-emerald-600 text-white px-4 py-3 rounded-lg shadow-2xl z-50 transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2 text-xs font-medium">
        <i data-lucide="info" class="w-4 h-4"></i>
        <span id="toastMsg">อัปเดตข้อมูลเรียบร้อยแล้ว</span>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        // Lucide Icons Render
        lucide.createIcons();

        // Epidemiology Master Dataset
        const PROVINCES_DATA = [
            { name: "กรุงเทพมหานคร", region: "central", lat: 13.7563, lng: 100.5018, cases: 8450, deaths: 6, pop: 5500000, risk: "high" },
            { name: "เชียงใหม่", region: "north", lat: 18.7883, lng: 98.9853, cases: 3120, deaths: 3, pop: 1780000, risk: "high" },
            { name: "นครราชสีมา", region: "ne", lat: 14.9799, lng: 102.0978, cases: 2890, deaths: 2, pop: 2630000, risk: "high" },
            { name: "สงขลา", region: "south", lat: 7.1988, lng: 100.5951, cases: 1950, deaths: 1, pop: 1430000, risk: "warning" },
            { name: "ชลบุรี", region: "central", lat: 13.3611, lng: 100.9847, cases: 2410, deaths: 2, pop: 1550000, risk: "high" },
            { name: "ขอนแก่น", region: "ne", lat: 16.4419, lng: 102.8360, cases: 2100, deaths: 1, pop: 1800000, risk: "warning" },
            { name: "อุบลราชธานี", region: "ne", lat: 15.2448, lng: 104.8473, cases: 1820, deaths: 2, pop: 1870000, risk: "warning" },
            { name: "สุราษฎร์ธานี", region: "south", lat: 9.1382, lng: 99.3217, cases: 1450, deaths: 1, pop: 1060000, risk: "warning" },
            { name: "พิษณุโลก", region: "north", lat: 16.8211, lng: 100.2659, cases: 1120, deaths: 0, pop: 850000, risk: "normal" },
            { name: "ภูเก็ต", region: "south", lat: 7.8804, lng: 98.3923, cases: 1680, deaths: 1, pop: 418000, risk: "high" },
            { name: "อุดรธานี", region: "ne", lat: 17.4138, lng: 102.7872, cases: 1540, deaths: 1, pop: 1580000, risk: "warning" },
            { name: "นครสวรรค์", region: "north", lat: 15.7022, lng: 100.1372, cases: 980, deaths: 0, pop: 1040000, risk: "normal" },
            { name: "นนทบุรี", region: "central", lat: 13.8591, lng: 100.5217, cases: 2210, deaths: 2, pop: 1270000, risk: "high" },
            { name: "ราชบุรี", region: "central", lat: 13.5373, lng: 99.8164, cases: 870, deaths: 0, pop: 870000, risk: "normal" },
            { name: "เชียงราย", region: "north", lat: 19.9105, lng: 99.8406, cases: 1290, deaths: 1, pop: 1290000, risk: "warning" },
            { name: "นครศรีธรรมราช", region: "south", lat: 8.4304, lng: 99.9631, cases: 1380, deaths: 1, pop: 1560000, risk: "normal" }
        ];

        let map;
        let markersLayer = L.layerGroup();
        let epiChartInstance = null;
        let ageChartInstance = null;
        let topChartInstance = null;

        function initMap() {
            // Center Thailand
            map = L.map('map', {
                center: [13.2, 101.0],
                zoom: 6,
                zoomControl: true
            });

            // ESRI World Dark Gray Canvas Base Tile Layer
            const esriDarkGrayBase = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ',
                maxZoom: 16
            }).addTo(map);

            // ESRI Dark Gray Reference Layer (Boundaries & City Labels)
            const esriDarkGrayLabels = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Reference/MapServer/tile/{z}/{y}/{x}', {
                attribution: '',
                maxZoom: 16,
                opacity: 0.85
            }).addTo(map);

            markersLayer.addTo(map);
            updateMapMarkers(PROVINCES_DATA);
        }

        function updateMapMarkers(data) {
            markersLayer.clearLayers();

            data.forEach(item => {
                const attackRate = ((item.cases / item.pop) * 100000).toFixed(1);
                
                // Color according to risk
                let color = "#22c55e"; // Normal
                let fillColor = "#22c55e";
                if (item.risk === "high") {
                    color = "#ef4444";
                    fillColor = "#ef4444";
                } else if (item.risk === "warning") {
                    color = "#f59e0b";
                    fillColor = "#f59e0b";
                }

                // Radius based on cases count
                const radius = Math.max(8, Math.min(28, Math.sqrt(item.cases) * 0.3));

                const circleMarker = L.circleMarker([item.lat, item.lng], {
                    radius: radius,
                    color: color,
                    weight: 2,
                    opacity: 0.9,
                    fillColor: fillColor,
                    fillOpacity: 0.45
                });

                // Custom Popup Box
                const popupContent = `
                    <div class="p-2 space-y-1 text-xs">
                        <div class="font-bold text-sm text-white flex items-center justify-between">
                            <span>${item.name}</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-medium ${
                                item.risk === 'high' ? 'bg-red-500/20 text-red-400 border border-red-500/30' :
                                item.risk === 'warning' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' :
                                'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                            }">
                                ${item.risk === 'high' ? 'ระบาดสูง' : item.risk === 'warning' ? 'เฝ้าระวัง' : 'ปกติ'}
                            </span>
                        </div>
                        <div class="text-slate-300 pt-1 space-y-0.5">
                            <div>จำนวนผู้ป่วย: <b class="text-emerald-400">${item.cases.toLocaleString()}</b> ราย</div>
                            <div>อัตราป่วย: <b class="text-amber-400">${attackRate}</b> /แสนประชากร</div>
                            <div>ผู้เสียชีวิต: <b class="text-rose-400">${item.deaths}</b> ราย</div>
                            <div class="text-[10px] text-slate-400 pt-1">ประชากร: ${(item.pop/10000).toFixed(1)} หมื่นคน</div>
                        </div>
                    </div>
                `;

                circleMarker.bindPopup(popupContent);
                markersLayer.addLayer(circleMarker);
            });
        }

        function initCharts() {
            // 1. Epi Curve Chart (Weekly Cases vs 5-Year Median Threshold)
            const ctxEpi = document.getElementById('epiCurveChart').getContext('2d');
            
            const weeks = Array.from({length: 42}, (_, i) => `W${i + 1}`);
            // Generate realistic epidemic curve with seasonal peak around W24-W32
            const currentYearCases = weeks.map((_, i) => {
                const base = Math.sin(i / 6) * 400 + 600;
                const noise = Math.random() * 150;
                return Math.round(base + noise);
            });

            const medianThreshold = weeks.map((_, i) => {
                const base = Math.sin(i / 6) * 320 + 500;
                return Math.round(base);
            });

            epiChartInstance = new Chart(ctxEpi, {
                type: 'bar',
                data: {
                    labels: weeks,
                    datasets: [
                        {
                            label: 'ค่ามัธยฐาน 5 ปี (Threshold)',
                            data: medianThreshold,
                            type: 'line',
                            borderColor: '#f59e0b',
                            borderWidth: 2,
                            borderDash: [4, 4],
                            pointRadius: 0,
                            fill: false,
                            tension: 0.3
                        },
                        {
                            label: 'ผู้ป่วยปี 2026',
                            data: currentYearCases,
                            backgroundColor: 'rgba(34, 197, 94, 0.65)',
                            borderColor: '#22c55e',
                            borderWidth: 1,
                            borderRadius: 3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: { color: '#94a3b8', font: { family: 'Sarabun', size: 11 } }
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#64748b', font: { size: 10 } },
                            grid: { display: false }
                        },
                        y: {
                            ticks: { color: '#64748b', font: { size: 10 } },
                            grid: { color: '#1e293b' }
                        }
                    }
                }
            });

            // 2. Age Group Chart
            const ctxAge = document.getElementById('ageGroupChart').getContext('2d');
            ageChartInstance = new Chart(ctxAge, {
                type: 'bar',
                data: {
                    labels: ['0-4 ปี', '5-14 ปี', '15-24 ปี', '25-34 ปี', '35-59 ปี', '60+ ปี'],
                    datasets: [
                        {
                            label: 'ชาย',
                            data: [420, 1250, 890, 610, 450, 210],
                            backgroundColor: '#3b82f6',
                            borderRadius: 4
                        },
                        {
                            label: 'หญิง',
                            data: [380, 1180, 840, 590, 480, 260],
                            backgroundColor: '#ec4899',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#94a3b8', font: { family: 'Sarabun', size: 11 } } }
                    },
                    scales: {
                        x: { ticks: { color: '#64748b', font: { size: 10 } }, grid: { display: false } },
                        y: { ticks: { color: '#64748b', font: { size: 10 } }, grid: { color: '#1e293b' } }
                    }
                }
            });

            // 3. Top Provinces Chart
            const ctxTop = document.getElementById('topProvincesChart').getContext('2d');
            topChartInstance = new Chart(ctxTop, {
                type: 'bar',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'อัตราป่วย/แสนประชากร',
                        data: [],
                        backgroundColor: '#f59e0b',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: { ticks: { color: '#64748b', font: { size: 10 } }, grid: { color: '#1e293b' } },
                        y: { ticks: { color: '#cbd5e1', font: { family: 'Sarabun', size: 11 } }, grid: { display: false } }
                    }
                }
            });

            updateTopProvincesChart(PROVINCES_DATA);
        }

        function updateTopProvincesChart(data) {
            // Sort by attack rate
            const sorted = [...data].map(p => ({
                name: p.name,
                rate: parseFloat(((p.cases / p.pop) * 100000).toFixed(1))
            })).sort((a, b) => b.rate - a.rate).slice(0, 8);

            topChartInstance.data.labels = sorted.map(d => d.name);
            topChartInstance.data.datasets[0].data = sorted.map(d => d.rate);
            topChartInstance.update();
        }

        function renderTable(data) {
            const tbody = document.getElementById('surveillanceTableBody');
            tbody.innerHTML = '';

            data.forEach(item => {
                const attackRate = ((item.cases / item.pop) * 100000).toFixed(1);
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/50 transition";

                let badgeHtml = '';
                if (item.risk === 'high') {
                    badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-red-500/20 text-red-400 border border-red-500/30">ระบาดสูง</span>';
                } else if (item.risk === 'warning') {
                    badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30">เฝ้าระวัง</span>';
                } else {
                    badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ปกติ</span>';
                }

                tr.innerHTML = `
                    <td class="py-2.5 px-4 font-medium text-slate-200 flex items-center gap-1.5">
                        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-slate-400"></i>
                        ${item.name}
                    </td>
                    <td class="py-2.5 px-4 text-right font-semibold text-slate-200">${item.cases.toLocaleString()}</td>
                    <td class="py-2.5 px-4 text-right text-amber-400 font-medium">${attackRate}</td>
                    <td class="py-2.5 px-4 text-right text-rose-400">${item.deaths}</td>
                    <td class="py-2.5 px-4 text-center">${badgeHtml}</td>
                    <td class="py-2.5 px-4 text-center">
                        <button onclick="zoomToProvince('${item.name}')" class="text-xs text-emerald-400 hover:text-emerald-300 underline font-medium">
                            ดูแผนที่
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            lucide.createIcons();
        }

        function handleFilterChange() {
            const disease = document.getElementById('diseaseSelect').value;
            const region = document.getElementById('regionSelect').value;
            const risk = document.getElementById('riskSelect').value;

            // Multiplier mock adjustment per disease selection
            let diseaseMultiplier = 1;
            if (disease === 'flu') diseaseMultiplier = 1.8;
            if (disease === 'covid') diseaseMultiplier = 2.4;
            if (disease === 'hfmd') diseaseMultiplier = 0.6;
            if (disease === 'diarrhea') diseaseMultiplier = 1.2;

            let filtered = PROVINCES_DATA.map(p => ({
                ...p,
                cases: Math.round(p.cases * diseaseMultiplier)
            }));

            if (region !== 'all') {
                filtered = filtered.filter(p => p.region === region);
            }

            if (risk !== 'all') {
                filtered = filtered.filter(p => p.risk === risk);
            }

            // Recalculate KPI summary metrics
            const totalCases = filtered.reduce((sum, item) => sum + item.cases, 0);
            const totalDeaths = filtered.reduce((sum, item) => sum + item.deaths, 0);
            const totalPop = filtered.reduce((sum, item) => sum + item.pop, 0);
            const attackRate = totalPop > 0 ? ((totalCases / totalPop) * 100000).toFixed(1) : "0.0";
            const cfr = totalCases > 0 ? ((totalDeaths / totalCases) * 100).toFixed(2) : "0.00";
            const redCount = filtered.filter(p => p.risk === 'high').length;

            document.getElementById('kpiTotalCases').innerText = totalCases.toLocaleString();
            document.getElementById('kpiAttackRate').innerText = attackRate;
            document.getElementById('kpiDeaths').innerText = totalDeaths;
            document.getElementById('kpiCFR').innerText = cfr + "%";
            document.getElementById('kpiRedProvinces').innerText = `${redCount} จังหวัด`;

            updateMapMarkers(filtered);
            renderTable(filtered);
            updateTopProvincesChart(filtered);

            showToast("อัปเดตการกรองข้อมูลแล้ว");
        }

        function zoomToProvince(provName) {
            const target = PROVINCES_DATA.find(p => p.name === provName);
            if (target && map) {
                map.flyTo([target.lat, target.lng], 9, { duration: 1.2 });
            }
        }

        function filterTable() {
            const query = document.getElementById('tableSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#surveillanceTableBody tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }

        function refreshData() {
            showToast("กำลังดึงข้อมูลระบาดวิทยาล่าสุด...");
            setTimeout(() => {
                handleFilterChange();
            }, 600);
        }

        function exportCSV() {
            let csvContent = "data:text/csv;charset=utf-8,\uFEFF";
            csvContent += "จังหวัด,เขต,จำนวนผู้ป่วย,ประชากร,อัตราป่วยต่อแสน,ผู้เสียชีวิต,ระดับความเสี่ยง\n";

            PROVINCES_DATA.forEach(p => {
                const attackRate = ((p.cases / p.pop) * 100000).toFixed(1);
                csvContent += `${p.name},${p.region},${p.cases},${p.pop},${attackRate},${p.deaths},${p.risk}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `epidemiology_report_W42_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showToast("ส่งออกไฟล์ CSV สำเร็จแล้ว");
        }

        function showActionModal() {
            showToast("กำลังจัดเตรียมเอกสารสรุปรายงาน สร.36...");
        }

        window.onload = function() {
            initMap();
            initCharts();
            renderTable(PROVINCES_DATA);
        };
    </script>
</body>
</html>
